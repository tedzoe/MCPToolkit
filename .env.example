# Copy to .env and fill in. .env is gitignored. Never commit real keys.
# Blank = server runs in its keyless mode (where one exists) or reports KEY-NEEDED.

# --- Required only for the named service; fetch needs no credentials ---
GITHUB_PAT=              # fine-grained PAT, public-repo read only. https://github.com/settings/personal-access-tokens/new
BRAVE_API_KEY=           # https://api-dashboard.search.brave.com/register
TAVILY_API_KEY=          # https://app.tavily.com/sign-in
ALPHAVANTAGE_API_KEY=    # https://www.alphavantage.co/support/#api-key  (blank = public "demo" key, IBM only)

# --- Not secret, but SEC requires a real contact ---
# Replace with your own contact before using sec-edgar; leave blank otherwise.
SEC_EDGAR_USER_AGENT=

# --- Optional: raise rate limits / unlock extra tools ---
HF_TOKEN=                    # https://huggingface.co/settings/tokens (read scope)
EXA_API_KEY=                 # https://dashboard.exa.ai/api-keys
SEMANTIC_SCHOLAR_API_KEY=    # https://www.semanticscholar.org/product/api#api-key-form
NVD_API_KEY=                 # https://nvd.nist.gov/developers/request-an-api-key
